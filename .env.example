# Public origin and search metadata are configured in src/lib/metadata.ts.

# The public site defaults to checked-in snapshots. Set to "database" only
# after the CMS database has been migrated, seeded, and configured.
CMS_CONTENT_SOURCE=static

# CMS runtime database URLs are generated by `npm run cms:credentials` into
# the ignored .env.cms.runtime.local file. Use separate values per environment.
DATABASE_URL_PUBLIC=
DATABASE_URL_CMS=
DATABASE_URL_AUTH=

# Direct/offline setup URL. Do not add this to normal application runtime.
DATABASE_URL_MIGRATIONS=

# Optional credential-free Neon pooler URL template for cms:credentials;
# match AWS/Azure provider, region, endpoint, port, and database; use secure TLS.
# Only unique sslmode, channel_binding, and options=endpoint=... parameters;
# no credentials. Any endpoint option must preserve the migration route.
# DATABASE_URL_RUNTIME_ENDPOINT=

# Set to development, preview, or production. Preview cache scope also uses
# VERCEL_GIT_COMMIT_REF supplied by the hosting platform.
CMS_ENVIRONMENT=development

# Better Auth origin and signing secret. Secret must be at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# One private Vercel Blob store token with read/write access; server-side only.
BLOB_PRIVATE_READ_WRITE_TOKEN=

# One-time offline owner bootstrap only. Supply these to the command process,
# then remove them. Never leave bootstrap credentials in deployed runtime.
CMS_BOOTSTRAP_EMAIL=
CMS_BOOTSTRAP_PASSWORD=
# CMS_BOOTSTRAP_NAME=

# Gmail account and app password; server-side only
EMAIL=
EMAIL_PASS=

# Existing invisible reCAPTCHA v2 keys. Register deployment domains in Google.
NEXT_PUBLIC_RECAPTCHA_KEY=
RECAPTCHA_SECRET=
