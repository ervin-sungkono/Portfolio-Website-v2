# Public origin and search metadata are configured in src/lib/metadata.ts.

# GitHub CMS: leave both content variables empty to retain checked-in content.
# All five values are server-only; never use NEXT_PUBLIC_ for CMS settings.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_ADMIN_ID=
# A separate public repository name, never the application repository.
GITHUB_REPO=

# Gmail account and app password; server-side only
EMAIL=
EMAIL_PASS=

# Existing invisible reCAPTCHA v2 keys. Register deployment domains in Google.
NEXT_PUBLIC_RECAPTCHA_KEY=
RECAPTCHA_SECRET=
