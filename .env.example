# Public origin and search metadata are configured in src/lib/metadata.ts.

# Public content defaults to ervin-sungkono/web-assets on master.
# All CMS settings are server-only; never use NEXT_PUBLIC_ for them.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_ADMIN_ID=
# A separate public repository name, never the application repository.
GITHUB_REPO=
# Required when using a different content repository or owner.
GITHUB_CONTENT_OWNER=
GITHUB_CONTENT_BRANCH=

# Gmail account and app password; server-side only
EMAIL=
EMAIL_PASS=

# Existing invisible reCAPTCHA v2 keys. Register deployment domains in Google.
NEXT_PUBLIC_RECAPTCHA_KEY=
RECAPTCHA_SECRET=
