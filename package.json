{
  "name": "ervin-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:cms": "tsc --project tsconfig.cms.json --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "playwright test",
    "test:cms": "node --conditions=react-server --import tsx --test tests/cms/auth-config.test.ts tests/cms/cache-scope.test.ts tests/cms/credential-config.test.ts tests/cms/data-model.test.ts tests/cms/db-role-config.test.ts tests/cms/media-validation.test.ts",
    "test:cms:integration": "node --conditions=react-server --import tsx --test tests/cms/role-privileges.test.ts tests/cms/store.integration.test.ts",
    "test:cms:browser": "playwright test --config playwright.cms.config.ts",
    "cms:migrate": "node --import tsx scripts/cms-migrate.ts",
    "cms:credentials": "node --import tsx scripts/cms-credentials.ts",
    "cms:test-environment": "node --import tsx scripts/cms-test-environment.ts",
    "cms:seed": "node --import tsx scripts/cms-seed.ts",
    "cms:bootstrap-owner": "node --conditions=react-server --import tsx scripts/cms-bootstrap-owner.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tsparticles/basic": "4.4.0",
    "@tsparticles/engine": "4.4.0",
    "@tsparticles/interaction-external-repulse": "4.4.0",
    "@tsparticles/interaction-particles-links": "4.4.0",
    "@tsparticles/plugin-interactivity": "4.4.0",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "motion": "14.0.0",
    "next": "16.4.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
